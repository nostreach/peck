[Unit]
Description=peck daemon — Nostr-signaled WebRTC tunnel (netns VPN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root

# ─── 1. Start VPN namespace with WireGuard configs ───
# Place WG configs in /etc/peck/wg/. One config per tunnel.
# peck-vpn-netns.sh creates the 'peck' netns and brings up all tunnels.
ExecStartPre=+/usr/local/bin/peck-vpn-netns.sh up /etc/peck/wg/*.conf

# ─── 2. Read WG IPs from /run/peck-wg-ips ───
ExecStartPre=/bin/bash -c 'grep PECK_WG_IPS /run/peck-wg-ips > /run/peck-daemon.env 2>/dev/null || true'

# ─── 3. Daemon inside the namespace ───
# NOTE: no host→namespace port forwarder needed — the daemon is purely
# WebRTC/relay-signaled and never opens a TCP listener inside the netns
# (old spec-019 architecture did; removed 2026-08-14).
EnvironmentFile=-/run/peck-daemon.env
ExecStart=+/usr/bin/ip netns exec peck /opt/peck/venv/bin/python /opt/peck/daemon.py \
  --nsec-file /etc/peck/nsec \
  --ports 80:http://10.200.200.1:8080 \
  --relays wss://relay.damus.io,wss://relay.primal.net

# ─── Cleanup ───
# (old socat ExecStop removed with the port forwarder — see note above)
ExecStopPost=+/usr/local/bin/peck-vpn-netns.sh down

Restart=always
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=peck-daemon

[Install]
WantedBy=multi-user.target
